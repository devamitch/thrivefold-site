{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thrivefold-site",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "out",
  "assets": {
    "directory": "out",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "thrivefold.devamit.co.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
